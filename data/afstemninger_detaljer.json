n":[]},"SF":{"for":[121,219,16728,17628,18706,18707,19000,20359,20360,21365,21340],"imod":[],"fravaer":[43,15788,18709,21383,21361],"hverken":[]},"M":{"for":[57,19475],"imod":[],"fravaer":[145,15773,20380],"hverken":[]},"DD":{"for":[],"imod":[82,162,1146],"fravaer":[119,182,17629,20355],"hverken":[]},"EL":{"for":[15777,18694,21302,20411,21398],"imod":[],"fravaer":[109,16073,16582,20135],"hverken":[]},"V":{"for":[127,130,139,180,18699,18701],"imod":[],"fravaer":[168,206,1845,18696,18698],"hverken":[]},"RV":{"for":[18726,21475,21360,21380],"imod":[],"fravaer":[141,18729,21344],"hverken":[]},"KF":{"for":[20357],"imod":[],"fravaer":[189,15793,18713],"hverken":[]},"DF":{"for":[],"imod":[],"fravaer":[216,238,15763,20350,20356],"hverken":[]},"JF":{"for":[],"imod":[],"fravaer":[262],"hverken":[]},"ALT":{"for":[20351,21342],"imod":[],"fravaer":[15775,21368],"hverken":[]},"LA":{"for":[15779],"imod":[],"fravaer":[18703,18723],"hverken":[]},"BP":{"for":[],"imod":[18724],"fravaer":[],"hverken":[]},"SP":{"for":[],"imod":[],"fravaer":[20349],"hverken":[]},"IA":{"for":[],"imod":[],"fravaer":[21387],"hverken":[]}},"sag_resume":"Lovforslaget har til formål at gennemføre Europa-Parlamentets og Rådets direktiv (EU) 2024/1799 af 13. juni 2024 om fælles regler til fremme af reparation af varer og om ændring af forordning (EU) 2017/2394 og direktiv (EU) 2019/771 og (EU) 2020/1828 (det såkaldte Right to Repair-direktiv) i dansk ret. \n\nDet overordnede formål med direktivet er at fremme reparation af varer i stedet for at skifte varer ud. På den måde skal direktivet bidrage til et velfungerende indre marked for afhjælpningsydelser (reparationsydelser) og samtidig sikre et højt forbruger- og miljøbeskyttelsesniveau og fremme cirkulær økonomi. \n\nLovforslaget hovedpunkter omfatter en reparationspligt for fabrikanter, et fælles europæisk reparationsoplysningsskema, et myndighedstilsyn med overholdelse af lovens regler, en fælles europæisk onlineplatform for reparation og bestemmelser til understøttelse heraf og at reklamationsfristen forlænges.\n\nDirektivet er et totalharmoniseringsdirektiv, hvilket indebærer, at der inden for direktivets anvendelsesområde ikke kan fastsættes nationale særregler, medmindre direktivet udtrykkelig giver mulighed herfor. Direktivet giver medlemsstaterne valgfrihed på tre punkter vedrørende en længere tillægsfrist til reklamationsfristen og registrering på den europæiske onlineplatform for reparation. \n\nLovforslaget indebærer, at direktivet vil blive gennemført uden overimplementering, og der lægges op til ikke at udnytte valgmuligheden vedrørende tillægsfristen til reklamationsfristen i købeloven og til ikke at udnytte valgmulighederne i forbindelse med den europæiske onlineplatform for reparation.\n\nDet foreslås, at loven træder i kraft dagen efter bekendtgørelsen i Lovtidende, idet direktivets implementeringsfrist er den 31. juli 2026. \n","konklusion":"Forslaget er vedtaget.\nFor stemte 92 (S, SF, V, LA, M, KF, EL, RV, ALT og Emilie Schytte (UFG)),\nimod stemte 18 (DF, DD, BP, Jacob Harris (UFG) og Nadja Natalie Isaksen (UFG)),\nhverken for eller imod stemte 0.","kommentar":null},{"afstemning_id":10587,"vote_groups":{"for":[18,57,82,97,99,113,118,120,121,127,130,139,162,180,199,208,219,220,224,244,351,1146,9896,15760,15777,15779,15790,15791,16180,16351,16728,17628,18694,18699,18701,18706,18707,18711,18716,18717,18719,18724,18726,19000,19475,20351,20357,20358,20359,20360,20361,21475,21365,21340,21371,20365,20362,21360,21379,21342,21302,21404,21380,20411,21343,21398],"imod":[],"fravaer":[12,43,109,119,138,141,145,152,154,168,173,182,189,206,214,216,238,260,262,286,1845,15762,15763,15770,15773,15775,15776,15787,15788,15793,16073,16582,17629,18696,18698,18703,18708,18709,18713,18718,18720,18721,18723,18729,20135,20349,20350,20355,20356,21383,21361,21387,21344,21368,21338,20380],"hverken":[]},"vote_groups_by_party":{"S":{"for":[97,118,120,208,220,224,244,15760,16351,18716,18717,18719,20361,20362,21343],"imod":[],"fravae