inder omfattet af antikonceptionspraksis i Kalaallit Nunaat (spiralsagen) i perioden 1960-1991” indgået mellem den tidligere regering (Socialdemokratiet, Venstre, Moderaterne) Danmarksdemokraterne, Socialistisk Folkeparti, Liberal Alliance, Det Konservative Folkeparti, Enhedslisten, Radikale Venstre, Alternativet, Aaja Chemnitz, Aki-Matilda Høegh Dam, Anna Falkenberg og Sjúrdur Skaale.","konklusion":"Forslaget er vedtaget.\nFor stemte 100 (S, SF, V, LA, M, KF, EL, DD, RV, ALT, BP, IA, Emilie Schytte (UFG) og Jacob Harris (UFG)),\nimod stemte 10 (DF og Nadja Natalie Isaksen (UFG)),\nhverken for eller imod stemte 0.","kommentar":null},{"afstemning_id":10583,"vote_groups":{"for":[57,97,118,120,121,127,130,139,152,180,199,208,219,220,224,244,9896,15760,15777,15790,15791,16180,16351,16728,17628,18694,18699,18701,18706,18707,18711,18716,18717,18719,18726,19000,19475,20357,20358,20359,20360,20361,21475,21365,21340,20365,20362,21360,21404,21380,20411,21343,21398],"imod":[18,82,99,113,162,1146,15779,18724,20351,21371,21379,21342,21302],"fravaer":[12,43,109,119,138,141,145,154,168,173,182,189,206,214,216,238,260,262,286,351,1845,15762,15763,15770,15773,15775,15776,15787,15788,15793,16073,16582,17629,18696,18698,18703,18708,18709,18713,18718,18720,18721,18723,18729,20135,20349,20350,20355,20356,21383,21361,21387,21344,21368,21338,20380],"hverken":[]},"vote_groups_by_party":{"S":{"for":[97,118,120,152,208,220,224,244,15760,16351,18716,18717,18719,20361,20362,21343],"imod":[],"fravaer":[12,138,154,214,260,286,15762,15770,15776,15787,18718,18720],"hverken":[]},"Uden parti":{"for":[199,9896,15790,15791,16180,18711,20358,20365,21404],"imod":[18,99,113,21371,21379],"fravaer":[173,351,18708,18721,21338],"hverken":[]},"SF":{"for":[121,219,16728,17628,18706,18707,19000,20359,20360,21365,21340],"imod":[],"fravaer":[43,15788,18709,21383,21361],"hverken":[]},"M":{"for":[57,19475],"imod":[],"fravaer":[145,15773,20380],"hverken":[]},"DD":{"for":[],"imod":[82,162,1146],"fravaer":[119,182,17629,20355],"hverken":[]},"EL":{"for":[15777,18694,20411,21398],"imod":[21302],"fravaer":[109,16073,16582,20135],"hverken":[]},"V":{"for":[127,130,139,180,18699,18701],"imod":[],"fravaer":[168,206,1845,18696,18698],"hverken":[]},"RV":{"for":[18726,21475,21360,21380],"imod":[],"fravaer":[141,18729,21344],"hverken":[]},"KF":{"for":[20357],"imod":[],"fravaer":[189,15793,18713],"hverken":[]},"DF":{"for":[],"imod":[],"fravaer":[216,238,15763,20350,20356],"hverken":[]},"JF":{"for":[],"imod":[],"fravaer":[262],"hverken":[]},"ALT":{"for":[],"imod":[20351,21342],"fravaer":[15775,21368],"hverken":[]},"LA":{"for":[],"imod":[15779],"fravaer":[18703,18723],"hverken":[]},"BP":{"for":[],"imod":[18724],"fravaer":[],"hverken":[]},"SP":{"for":[],"imod":[],"fravaer":[20349],"hverken":[]},"IA":{"for":[],"imod":[],"fravaer":[21387],"hverken":[]}},"sag_resume":"Forslaget gennemfører dele af EU’s pagt om migration og asyl, som Europa-Parlamentet og Rådet vedtog den 14. maj 2024. Pagten har til formål at styrke kontrollen med Danmarks ydre grænser, øge sikkerheden i Schengenområdet, forbedre hjemsendelse af udlændinge uden lovligt ophold, sikre en retfærdig fordeling af asylansøgere mellem medlemsstaterne og styrke EU’s beredskab i krisesituationer.\n\nMed lovforslaget gennemføres de dele af forordningen om Asyl- og Migrationsforvaltning (AM-forordningen), kriseforordningen og Eurodac-forordningen, som Danmark på mellemstatsligt grundlag har tilsluttet sig i overensstemmelse med parallelaftalen, og screeningforordningen og grænsetilbagesendelsesprocedureforordningen, som Danmark har tilsluttet sig i overensstemmelse med Schengenteknikaliteten.\n\nHerudover giver lovforslaget udlændinge- og integrationsministeren mulighed for i særlige tilfælde at indføre en asylgrænseprocedure ved Danmarks ydre grænser, hvorefter visse asylansøgninger i en periode på 6 måneder vil kunne behandles i en særlig hurtig proces, ligesom et afslag på asyl vil indebære en forenklet tilbagesendelsesprocedure.\n\n","k